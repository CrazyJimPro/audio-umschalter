            "Headset": "headset",
            "Monitor": "monitor",
            "Lautsprecher": "lautsprecher"
        }
    },
    "symbol2": {
        "type": "combobox",
        "default": "auto",
        "description": "Symbol für Klick-Ziel 2",
        "options": {
            "Automatisch erkennen": "auto",
            "Headset": "headset",
            "Monitor": "monitor",
            "Lautsprecher": "lautsprecher"
        }
    },
